{
  "name": "@jalik/hal",
  "version": "2.0.0",
  "description": "Hypertext Application Language toolbox",
  "license": "MIT",
  "keywords": [
    "hal",
    "hypertext",
    "language",
    "json",
    "api",
    "rest"
  ],
  "author": {
    "name": "Karl Stein",
    "email": "karl.stein.pro@gmail.com",
    "url": "https://github.com/jalik"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jalik/js-hal.git"
  },
  "bugs": {
    "url": "https://github.com/jalik/js-hal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js"
    }
  },
  "files": [
    "esm/",
    "LICENSE.txt",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf ./esm && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run prepublishOnly",
    "test": "npm run typecheck && vitest run --passWithNoTests --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
