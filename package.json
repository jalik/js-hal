{
  "name": "@jalik/hal",
  "version": "1.0.3",
  "description": "Hypertext Application Language toolbox",
  "license": "MIT",
  "keywords": [
    "hal",
    "hypertext",
    "language",
    "json",
    "api",
    "rest"
  ],
  "author": {
    "name": "Karl Stein",
    "email": "karl.stein.pro@gmail.com",
    "url": "https://github.com/jalik"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jalik/js-hal.git"
  },
  "bugs": {
    "url": "https://github.com/jalik/js-hal/issues"
  },
  "sideEffects": false,
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "files": [
    "cjs/",
    "esm/",
    "LICENSE.txt",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build-cjs && npm run build-esm",
    "build-cjs": "tsc -p tsconfig.cjs.json",
    "build-esm": "tsc",
    "clean": "rimraf ./cjs ./esm",
    "dev-cjs": "tsc --watch -p tsconfig.cjs.json",
    "dev-esm": "tsc --watch",
    "dev": "concurrently 'npm:dev-*'",
    "lint": "oxlint .",
    "lint-fix": "oxlint --fix .",
    "prepare": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run prepublishOnly",
    "test": "npm run typecheck && vitest run --passWithNoTests --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
